# ────────────────────────────────────────────────────────────────
#  AURA Frontend – Environment Reference
#  Copy this file to .env and fill in your values.
#  ⚠️  Never commit .env to version control.
# ────────────────────────────────────────────────────────────────

# Full URL of the Django backend running on DigitalOcean.
# Include the scheme (https:// or http://) and NO trailing slash.
# Examples:
#   API_BASE_URL=https://api.aura.yourdomain.com
#   API_BASE_URL=http://123.45.67.89
#
# For local Docker development this value is unused — Nginx proxy
# handles /api/ → http://backend:8000 automatically.
API_BASE_URL=https://your-digitalocean-backend.com
